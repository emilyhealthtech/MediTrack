# MediTrack — Environment Variables Example
# Copy this file to .env in relevant apps/packages for local development.

# Application Environment
NODE_ENV=development
PORT=3001

# Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Connection (SQLite default for local dev/test, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Security & Secrets
JWT_SECRET=super-secret-development-jwt-token-key-change-in-production
CORS_ORIGIN=http://localhost:3000
