datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PATIENT
  FACILITY_STAFF
  FACILITY_ADMIN
  SYSTEM_ADMIN
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum HealthInfoSource {
  PATIENT_ENTERED
  CLINICIAN_VERIFIED
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  LIFE_THREATENING
}

enum ConditionStatus {
  ACTIVE
  RESOLVED
  CHRONIC
}

enum MedicationStatus {
  ACTIVE
  DISCONTINUED
}

enum MedicalHistoryCategory {
  SURGERY
  HOSPITALIZATION
  IMMUNIZATION
  FAMILY_HISTORY
  GENERAL
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  passwordHash  String
  fullName      String
  phoneNumber   String?
  role          Role         @default(PATIENT)
  isVerified    Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  memberships   Membership[]
  patientProfile Patient?
  auditEvents   AuditEvent[]

  verifiedAllergies       PatientAllergy[]        @relation("VerifiedAllergies")
  verifiedConditions      PatientCondition[]      @relation("VerifiedConditions")
  verifiedMedications     PatientMedication[]     @relation("VerifiedMedications")
  verifiedMedicalHistory  PatientMedicalHistory[] @relation("VerifiedMedicalHistory")

  @@map("users")
}

model Organization {
  id            String       @id @default(uuid())
  name          String
  slug          String       @unique
  rcNumber      String?      // Nigerian CAC RC Number
  isVerified    Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  facilities    Facility[]
  memberships   Membership[]
  subscriptions Subscription[]
  patients      Patient[]
  appointments  Appointment[]

  @@map("organizations")
}

model Facility {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  address        String
  city           String
  state          String       // Nigerian state e.g. Lagos, Abuja, Kano
  phone          String
  email          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments   Appointment[]

  @@map("facilities")
}

model Membership {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  role           Role         @default(FACILITY_STAFF)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("memberships")
}

model Patient {
  id                         String       @id @default(uuid())
  userId                     String       @unique
  organizationId             String?
  dateOfBirth                DateTime?
  gender                     String?
  bloodGroup                 String?
  genotype                   String?      // e.g., AA, AS, SS
  emergencyContact           String?
  emergencyContactName       String?
  emergencyContactPhone      String?
  emergencyContactRelationship String?
  address                    String?
  city                       String?
  state                      String?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  user                       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization               Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  appointments               Appointment[]

  allergies                  PatientAllergy[]
  conditions                 PatientCondition[]
  medications                PatientMedication[]
  medicalHistory             PatientMedicalHistory[]

  @@map("patients")
}

model PatientAllergy {
  id                    String          @id @default(uuid())
  patientId             String
  allergen              String
  severity              AllergySeverity @default(MODERATE)
  reaction              String?
  source                HealthInfoSource @default(PATIENT_ENTERED)
  isVerifiedByClinician Boolean         @default(false)
  verifiedByUserId      String?
  verifiedAt            DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  patient               Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  verifiedByUser        User?           @relation("VerifiedAllergies", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@map("patient_allergies")
}

model PatientCondition {
  id                    String          @id @default(uuid())
  patientId             String
  conditionName         String
  diagnosedDate         DateTime?
  status                ConditionStatus @default(ACTIVE)
  source                HealthInfoSource @default(PATIENT_ENTERED)
  isVerifiedByClinician Boolean         @default(false)
  verifiedByUserId      String?
  verifiedAt            DateTime?
  notes                 String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  patient               Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  verifiedByUser        User?           @relation("VerifiedConditions", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@map("patient_conditions")
}

model PatientMedication {
  id                    String           @id @default(uuid())
  patientId             String
  medicationName        String
  dosage                String?
  frequency             String?
  startDate             DateTime?
  endDate               DateTime?
  status                MedicationStatus @default(ACTIVE)
  source                HealthInfoSource @default(PATIENT_ENTERED)
  isVerifiedByClinician Boolean          @default(false)
  verifiedByUserId      String?
  verifiedAt            DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  patient               Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  verifiedByUser        User?            @relation("VerifiedMedications", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@map("patient_medications")
}

model PatientMedicalHistory {
  id                    String                 @id @default(uuid())
  patientId             String
  title                 String
  description           String?
  eventDate             DateTime?
  category              MedicalHistoryCategory @default(GENERAL)
  source                HealthInfoSource       @default(PATIENT_ENTERED)
  isVerifiedByClinician Boolean                @default(false)
  verifiedByUserId      String?
  verifiedAt            DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  patient               Patient                @relation(fields: [patientId], references: [id], onDelete: Cascade)
  verifiedByUser        User?                  @relation("VerifiedMedicalHistory", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@map("patient_medical_history")
}

model Appointment {
  id             String            @id @default(uuid())
  organizationId String
  facilityId     String
  patientId      String
  scheduledAt    DateTime
  department     String
  reason         String?
  status         AppointmentStatus @default(SCHEDULED)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facility       Facility          @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  patient        Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("appointments")
}

model SubscriptionPlan {
  id            String         @id @default(uuid())
  name          String
  tier          String         @unique // e.g. STARTER, PROFESSIONAL, ENTERPRISE
  priceNGN      Int
  maxFacilities Int
  maxStaff      Int
  createdAt     DateTime       @default(now())

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id             String             @id @default(uuid())
  organizationId String             @unique
  planId         String
  status         SubscriptionStatus @default(TRIALING)
  currentPeriodEnd DateTime
  createdAt      DateTime           @default(now())

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan           SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@map("subscriptions")
}

model AuditEvent {
  id          String   @id @default(uuid())
  userId      String?
  organizationId String?
  action      String
  entity      String
  entityId    String?
  ipAddress   String?
  userAgent   String?
  detailsJson String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_events")
}

model Notification {
  id        String   @id @default(uuid())
  recipient String   // Email or phone number
  channel   String   // EMAIL, SMS, IN_APP
  subject   String?
  content   String
  isSent    Boolean  @default(false)
  sentAt    DateTime?
  createdAt DateTime @default(now())

  @@map("notifications")
}
