datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PATIENT
  FACILITY_STAFF
  FACILITY_ADMIN
  SYSTEM_ADMIN
}

enum AppointmentStatus {
  REQUESTED
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ConsultationMode {
  IN_PERSON
  VIRTUAL
  TELEPHONE
}

enum EncounterStatus {
  DRAFT
  SIGNED
  AMENDED
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum HealthInfoSource {
  PATIENT_ENTERED
  CLINICIAN_VERIFIED
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  LIFE_THREATENING
}

enum ConditionStatus {
  ACTIVE
  RESOLVED
  CHRONIC
}

enum MedicationStatus {
  ACTIVE
  DISCONTINUED
}

enum MedicalHistoryCategory {
  SURGERY
  HOSPITALIZATION
  IMMUNIZATION
  FAMILY_HISTORY
  GENERAL
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  passwordHash  String
  fullName      String
  phoneNumber   String?
  role          Role         @default(PATIENT)
  isVerified    Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  memberships   Membership[]
  patientProfile Patient?
  auditEvents   AuditEvent[]

  verifiedAllergies       PatientAllergy[]        @relation("VerifiedAllergies")
  verifiedConditions      PatientCondition[]      @relation("VerifiedConditions")
  verifiedMedications     PatientMedication[]     @relation("VerifiedMedications")
  verifiedMedicalHistory  PatientMedicalHistory[] @relation("VerifiedMedicalHistory")

  providerAppointments    Appointment[]           @relation("ProviderAppointments")
  providerAvailabilities  ProviderAvailability[]
  clinicianEncounters     Encounter[]             @relation("ClinicianEncounters")
  signedEncounters        Encounter[]             @relation("SignedEncounters")
  encounterAmendments     EncounterAmendment[]

  @@map("users")
}

model Organization {
  id            String       @id @default(uuid())
  name          String
  slug          String       @unique
  rcNumber      String?      // Nigerian CAC RC Number
  isVerified    Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  facilities             Facility[]
  memberships            Membership[]
  invitations            Invitation[]
  subscriptions          Subscription[]
  patients               Patient[]
  appointments           Appointment[]
  providerAvailabilities ProviderAvailability[]
  encounters             Encounter[]

  @@map("organizations")
}

model Facility {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  address        String
  city           String
  state          String       // Nigerian state e.g. Lagos, Abuja, Kano
  phone          String
  email          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments           Appointment[]
  providerAvailabilities ProviderAvailability[]
  encounters             Encounter[]

  @@map("facilities")
}

model Membership {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  role           Role         @default(FACILITY_STAFF)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("memberships")
}

model Patient {
  id                         String       @id @default(uuid())
  userId                     String       @unique
  organizationId             String?
  dateOfBirth                DateTime?
  gender                     String?
  bloodGroup                 String?
  genotype                   String?      // e.g., AA, AS, SS
  emergencyContact           String?
  emergencyContactName       String?
  emergencyContactPhone      String?
  emergencyContactRelationship String?
  address                    String?
  city                       String?
  state                      String?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  user                       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization               Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  appointments               Appointment[]

  allergies                  PatientAllergy[]
  conditions                 PatientCondition[]
  medications                PatientMedication[]
  medicalHistory             PatientMedicalHistory[]
  encounters                 Encounter[]

  @@map("patients")
}

model PatientAllergy {
  id                    String          @id @default(uuid())
  patientId             String
  allergen              String
  severity              AllergySeverity @default(MODERATE)
  reaction              String?
  source                HealthInfoSource @default(PATIENT_ENTERED)
  isVerifiedByClinician Boolean         @default(false)
  verifiedByUserId      String?
  verifiedAt            DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  patient               Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  verifiedByUser        User?           @relation("VerifiedAllergies", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@map("patient_allergies")
}

model PatientCondition {
  id                    String          @id @default(uuid())
  patientId             String
  conditionName         String
  diagnosedDate         DateTime?
  status                ConditionStatus @default(ACTIVE)
  source                HealthInfoSource @default(PATIENT_ENTERED)
  isVerifiedByClinician Boolean         @default(false)
  verifiedByUserId      String?
  verifiedAt            DateTime?
  notes                 String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  patient               Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  verifiedByUser        User?           @relation("VerifiedConditions", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@map("patient_conditions")
}

model PatientMedication {
  id                    String           @id @default(uuid())
  patientId             String
  medicationName        String
  dosage                String?
  frequency             String?
  startDate             DateTime?
  endDate               DateTime?
  status                MedicationStatus @default(ACTIVE)
  source                HealthInfoSource @default(PATIENT_ENTERED)
  isVerifiedByClinician Boolean          @default(false)
  verifiedByUserId      String?
  verifiedAt            DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  patient               Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  verifiedByUser        User?            @relation("VerifiedMedications", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@map("patient_medications")
}

model PatientMedicalHistory {
  id                    String                 @id @default(uuid())
  patientId             String
  title                 String
  description           String?
  eventDate             DateTime?
  category              MedicalHistoryCategory @default(GENERAL)
  source                HealthInfoSource       @default(PATIENT_ENTERED)
  isVerifiedByClinician Boolean                @default(false)
  verifiedByUserId      String?
  verifiedAt            DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  patient               Patient                @relation(fields: [patientId], references: [id], onDelete: Cascade)
  verifiedByUser        User?                  @relation("VerifiedMedicalHistory", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@map("patient_medical_history")
}

model Appointment {
  id                 String            @id @default(uuid())
  organizationId     String
  facilityId         String
  patientId          String
  providerId         String?
  scheduledAt        DateTime
  durationMinutes    Int               @default(30)
  department         String
  reason             String?
  mode               ConsultationMode  @default(IN_PERSON)
  timeZone           String            @default("Africa/Lagos")
  status             AppointmentStatus @default(SCHEDULED)
  notes              String?
  cancellationReason String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facility           Facility          @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  patient            Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider           User?             @relation("ProviderAppointments", fields: [providerId], references: [id], onDelete: SetNull)
  encounters         Encounter[]

  @@map("appointments")
}

model ProviderAvailability {
  id                 String       @id @default(uuid())
  organizationId     String
  facilityId         String
  providerId         String
  dayOfWeek          Int          // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime          String       // "08:00"
  endTime            String       // "17:00"
  slotDurationMinutes Int         @default(30)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facility           Facility     @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  provider           User         @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([facilityId, providerId, dayOfWeek])
  @@map("provider_availabilities")
}

model Encounter {
  id                      String               @id @default(uuid())
  organizationId          String
  facilityId              String
  patientId               String
  appointmentId           String?
  clinicianId             String
  status                  EncounterStatus      @default(DRAFT)
  encounterDate           DateTime             @default(now())
  chiefComplaint          String?
  historyOfPresentIllness String?
  assessment              String?
  plan                    String?
  vitalsJson              String?              // Encoded JSON object for vital signs
  isConfidential          Boolean              @default(false)
  signedAt                DateTime?
  signedById              String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  organization            Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facility                Facility             @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  patient                 Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment             Appointment?         @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  clinician               User                 @relation("ClinicianEncounters", fields: [clinicianId], references: [id], onDelete: Restrict)
  signedBy                User?                @relation("SignedEncounters", fields: [signedById], references: [id], onDelete: SetNull)
  amendments              EncounterAmendment[]

  @@map("encounters")
}

model EncounterAmendment {
  id               String       @id @default(uuid())
  encounterId      String
  amendedById      String
  reason           String
  previousDataJson String
  newDataJson      String
  createdAt        DateTime     @default(now())

  encounter        Encounter    @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  amendedBy        User         @relation(fields: [amendedById], references: [id], onDelete: Restrict)

  @@map("encounter_amendments")
}

model SubscriptionPlan {
  id            String         @id @default(uuid())
  name          String
  tier          String         @unique // e.g. STARTER, PROFESSIONAL, ENTERPRISE
  priceNGN      Int
  maxFacilities Int
  maxStaff      Int
  createdAt     DateTime       @default(now())

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id             String             @id @default(uuid())
  organizationId String             @unique
  planId         String
  status         SubscriptionStatus @default(TRIALING)
  currentPeriodEnd DateTime
  createdAt      DateTime           @default(now())

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan           SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@map("subscriptions")
}

model AuditEvent {
  id          String   @id @default(uuid())
  userId      String?
  organizationId String?
  action      String
  entity      String
  entityId    String?
  ipAddress   String?
  userAgent   String?
  detailsJson String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_events")
}

model Notification {
  id            String   @id @default(uuid())
  recipient     String   // Email or phone number
  channel       String   // EMAIL, SMS, IN_APP
  subject       String?
  content       String
  isSent        Boolean  @default(false)
  status        String   @default("SENT") // SENT, FAILED, PENDING
  failureReason String?
  retryCount    Int      @default(0)
  sentAt        DateTime?
  createdAt     DateTime @default(now())

  @@map("notifications")
}

model OrganizationApplication {
  id               String    @id @default(uuid())
  organizationName String
  slug             String    @unique
  rcNumber         String?
  contactName      String
  contactEmail     String
  contactPhone     String?
  state            String
  status           String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewNotes      String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("organization_applications")
}

model Invitation {
  id             String       @id @default(uuid())
  organizationId String
  email          String
  role           Role         @default(FACILITY_STAFF)
  tokenHash      String       @unique
  inviterId      String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("invitations")
}
