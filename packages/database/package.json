{
  "name": "@meditrack/database",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "prisma generate --schema=prisma/schema.prisma && tsc",
    "typecheck": "prisma generate --schema=prisma/schema.prisma && tsc --noEmit",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.9.1"
  },
  "devDependencies": {
    "prisma": "^5.9.1",
    "typescript": "^5.3.3"
  }
}
